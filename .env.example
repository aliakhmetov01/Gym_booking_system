# Copy this file to ".env" (same folder) and fill in the values.
# The .env file is ignored by git: never commit the real password.

# Supabase -> Connect -> Connection string -> URI -> "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
